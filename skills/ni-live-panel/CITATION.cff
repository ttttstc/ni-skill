repository-code: "https://github.com/ythx-101/live-panel-skill"
url: "https://github.com/ythx-101/live-panel-skill"
license: MIT
date-released: "2026-10-03"
keywords:
  - animated architecture diagram
  - architecture diagram
  - agent architecture
  - live panel
  - json to video
  - diagram as code
  - claude code skill
  - agent skill
  - mp4
  - xiaohongshu
